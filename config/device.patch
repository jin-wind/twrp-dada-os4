diff --git a/recovery/root/odm/bin/prepdecrypt.sh b/recovery/root/odm/bin/prepdecrypt.sh
index 9ce2b5d..3acccd3 100644
--- a/recovery/root/odm/bin/prepdecrypt.sh
+++ b/recovery/root/odm/bin/prepdecrypt.sh
@@ -100,9 +100,29 @@ wait_for_service() {
 
 # The HAL reads the version properties in its constructor and hands them to the
 # TA, so it is left disabled until they match the installed system. Start it
-# even when they could not be read: keystore2 blocks until KeyMint registers,
-# and nothing decrypts without it.
+# only after the installed system and verified boot patch values match.
+# A blocked check leaves decryption unavailable without upgrading stored keys.
 start_crypto_services() {
+	# This image is specifically for the verified OS4.0.0.11 payload. Never
+	# configure KeyMint using TWRP's fallback OS 99 / patch level 2099 values.
+	if [ "$(getprop ro.build.version.release)" != "17" ] ||
+	   [ "$(getprop ro.build.version.security_patch)" != "2026-09-01" ] ||
+	   [ "$(getprop ro.vendor.build.security_patch)" != "2026-09-01" ]; then
+		log_print 0 "OS4 port: refusing KeyMint with unexpected platform properties."
+		setprop twrp.port.crypto_blocked 1
+		setprop crypto.ready 0
+		return 1
+	fi
+	# Taken from com.android.build.boot.security_patch in the stock boot AVB
+	# metadata, not from the build tree's deliberately synthetic defaults.
+	$setprop_bin ro.bootimage.build.version.security_patch 2026-09-01
+	if [ "$(getprop ro.bootimage.build.version.security_patch)" != "2026-09-01" ]; then
+		log_print 0 "OS4 port: boot patch property could not be set correctly."
+		setprop twrp.port.crypto_blocked 1
+		setprop crypto.ready 0
+		return 1
+	fi
+	setprop twrp.port.crypto_blocked 0
 	log_print 1 "Starting KeyMint..."
 	setprop ctl.start vendor.keymint-qti
 	wait_for_service vendor.keymint-qti running
@@ -125,7 +145,7 @@ finish() {
 			fi
 		fi
 	fi
-	start_crypto_services
+	start_crypto_services || exit 2
 	setprop crypto.ready 1
 	log_print 1 "crypto.ready=$(getprop crypto.ready)"
 	log_print 1 "Script complete. Device ready for decryption."
@@ -149,8 +169,8 @@ finish_error() {
 			fi
 		fi
 	fi
-	start_crypto_services
-	setprop crypto.ready 1
+	setprop twrp.port.crypto_blocked 1
+	setprop crypto.ready 0
 	log_print 0 "Script run incomplete. Device may not be ready for decryption."
 	exit 2
 }
